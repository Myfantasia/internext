# ============================================================================
# Internext Business System — Environment Configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ============================================================================

# --- App ---
NODE_ENV=development
PORT=4000
# Public URL(s) of the storefront. Comma-separate several (e.g. Vercel URL + custom domain).
# Used for CORS, CSRF origin checks, email links and payment return URLs.
APP_URL=http://localhost:5174
# Set to true when running behind a reverse proxy (Nginx, Render, Railway…) so rate limits see real client IPs.
TRUST_PROXY=false

# --- Database (dedicated Postgres role/db for this app only) ---
DATABASE_URL=postgres://ibs_app:CHANGE_ME@localhost:5432/internext_ibs

# --- Auth / Sessions ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_64_HEX_CHARS
COOKIE_NAME=ibs_session
# Set to true only when serving over HTTPS (production)
COOKIE_SECURE=false
# Absolute session lifetime. After this the user must sign in again.
SESSION_TTL_HOURS=3

# --- Admin bootstrap (used once by `npm run bootstrap:admin`, never a live HTTP endpoint) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Email ---------------------------------------------------------------------
# EMAIL_PROVIDER=smtp sends real email; "console" prints emails to the server log.
# If omitted, smtp is used automatically when SMTP_HOST is set.
EMAIL_PROVIDER=console
SMTP_HOST=
# 587 = STARTTLS (most providers), 465 = TLS from the start
SMTP_PORT=587
# true for port 465, false for 587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to customers
EMAIL_FROM_NAME="Internext Business System"
EMAIL_FROM_ADDRESS=no-reply@internextbusinesssystem.co.ke
# Where customer replies go (optional)
EMAIL_REPLY_TO=info@internextbusinesssystem.co.ke
# Email branding (optional — sensible defaults are built in)
EMAIL_BRAND_NAME="Internext Business System"
EMAIL_BRAND_TAGLINE="We Make Technology Happen"
EMAIL_BRAND_COLOR=#1f4d3a
EMAIL_ACCENT_COLOR=#2f7a57
# Must be a public https URL (email clients cannot load localhost images)
EMAIL_LOGO_URL=
EMAIL_FOOTER_ADDRESS="Princely House, 1st Floor, Moi Avenue, Nairobi · P.O. Box 16806-00100"
EMAIL_FOOTER_CONTACT="+254 722 664 457 · info@internextbusinesssystem.co.ke"
EMAIL_SUPPORT_URL=

# --- Stripe (card / Visa / Mastercard via Stripe Checkout) ---------------------
# Test keys start with sk_test_. Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=
# From `stripe listen` (local) or Dashboard → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=kes

# --- M-Pesa Daraja (STK Push) ----------------------------------------------------
# sandbox | production | simulation (simulation = no network, dev only, refused in production)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox test shortcode is 174379; its passkey is shown on the Daraja simulator page.
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# CustomerPayBillOnline (Paybill) or CustomerBuyGoodsOnline (Till)
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Only for Buy Goods: the till number (otherwise defaults to MPESA_SHORTCODE)
MPESA_PARTY_B=
# Public HTTPS base URL Safaricom can reach (ngrok URL locally), no trailing slash.
MPESA_CALLBACK_BASE_URL=
# Long random string; becomes part of the callback URL. Generate: openssl rand -hex 24
MPESA_CALLBACK_SECRET=
# Re-check "success" callbacks with Daraja's STK query before marking orders paid.
MPESA_VERIFY_CALLBACKS=true

# --- Reviews ---------------------------------------------------------------------
# false = new reviews go live immediately; true (default) = staff approve first.
REVIEWS_REQUIRE_MODERATION=true

# --- Tech news -----------------------------------------------------------------------
# Auto-import RSS feeds every N minutes (min 15; 0 = only when an admin clicks "Fetch").
NEWS_FETCH_INTERVAL_MINUTES=0

# --- Vercel Cron -----------------------------------------------------------------
# Protects GET /api/cron/housekeeping (expires unpaid orders). Vercel sends it as a
# Bearer token automatically when this variable is set in the project. openssl rand -hex 24
CRON_SECRET=

# --- Image uploads -----------------------------------------------------------------
# Empty = save to the local uploads/ folder (development). On Vercel, connect a Blob
# store (Storage → Blob) and Vercel sets this automatically.
BLOB_READ_WRITE_TOKEN=
